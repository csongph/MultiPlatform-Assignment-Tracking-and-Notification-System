DATABASE_URL=postgresql+asyncpg://kmaps:kmaps@localhost:5432/kmaps_db
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

TOKEN_ENCRYPTION_KEY=change-me-to-another-long-random-secret

GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google_classroom/callback

MICROSOFT_OAUTH_CLIENT_ID=your-microsoft-client-id
MICROSOFT_OAUTH_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_OAUTH_TENANT=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/microsoft_teams/callback

FRONTEND_ORIGIN=http://localhost:5500
FRONTEND_ONBOARDING_SUCCESS_PATH=/onboarding/success
FRONTEND_ONBOARDING_ERROR_PATH=/onboarding/error

SYNC_INTERVAL_MINUTES=10
NOTIFICATION_POLL_INTERVAL_SECONDS=60
NOTIFICATION_MAX_RETRIES=3

# Gmail API sender account. Authorize only the KMAPS sender account once with
# https://www.googleapis.com/auth/gmail.send, then store its refresh token.
# Do not use student OAuth tokens or commit any of these values.
GMAIL_SENDER_CLIENT_ID=your-gmail-oauth-client-id
GMAIL_SENDER_CLIENT_SECRET=your-gmail-oauth-client-secret
GMAIL_SENDER_REFRESH_TOKEN=sender-account-refresh-token
GMAIL_SENDER_FROM_EMAIL=your-gmail-address@gmail.com
GMAIL_SENDER_FROM_NAME=KMAPS Notifications
GMAIL_SENDER_REDIRECT_URI=http://localhost:8085
TOKEN_REFRESH_LEAD_MINUTES=15
CACHE_TTL_SECONDS=300
