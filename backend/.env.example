DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE?ssl=require

JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

TOKEN_ENCRYPTION_KEY=replace-with-a-random-encryption-secret
REDIS_URL=redis://127.0.0.1:6379

GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google_classroom/callback

MICROSOFT_OAUTH_CLIENT_ID=your-microsoft-client-id
MICROSOFT_OAUTH_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_OAUTH_TENANT=organizations
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/microsoft_teams/callback

FRONTEND_ORIGIN=http://localhost:5500
# Add other exact origins separated by commas; no trailing slash.
FRONTEND_ORIGINS=
FRONTEND_ONBOARDING_SUCCESS_PATH=/pages/onboarding.html
FRONTEND_ONBOARDING_ERROR_PATH=/pages/onboarding.html
FORWARDED_ALLOW_IPS=127.0.0.1

SYNC_INTERVAL_MINUTES=10
NOTIFICATION_POLL_INTERVAL_SECONDS=60
NOTIFICATION_MAX_RETRIES=3

# Gmail SMTP sender. Use a Google App Password, not the account's normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-sender@gmail.com
SMTP_FROM_NAME=KMAPS
SMTP_USE_TLS=true
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_MAX_OTP_ATTEMPTS=5
TOKEN_REFRESH_LEAD_MINUTES=15
CACHE_TTL_SECONDS=300
